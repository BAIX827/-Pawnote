{
  "expo": {
    "name": "爪记",
    "slug": "paw-life",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/pawnote-icon-outline.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.baricy.pawlife.dev",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "zh_CN",
        "CFBundleLocalizations": ["zh-Hans", "en"]
      }
    },
    "android": {
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "爪记",
      "favicon": "./assets/pawnote-icon-outline.png"
    },
    "scheme": "pawlife",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "选择宠物照片作为头像和日常记录。",
          "cameraPermission": "拍摄宠物日常照片。",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-notifications"
    ]
  }
}
