{
  "expo": {
    "name": "Paw Note",
    "slug": "paw-life",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/pawnote-icon-en.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.baricy.pawlife.dev",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en"
        ]
      }
    },
    "android": {
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Paw Note",
      "favicon": "./assets/pawnote-icon-en.png"
    },
    "scheme": "pawlife",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos for your pet’s profile and diary.",
          "cameraPermission": "Take photos for your pet’s diary.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-sharing",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "Record sounds your pet makes for your diary.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ]
    ]
  }
}
