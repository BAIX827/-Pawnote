# Copy to server/.env and fill in. server/.env is ignored by git.
PORT=8787
# Free AI generations per device per week for non-members.
FREE_AI_PER_WEEK=2
# Comma-separated device ids treated as members until real subscriptions exist.
MEMBER_DEVICE_IDS=

# Mainland China: DeepSeek.
CN_BASE_URL=https://api.deepseek.com
CN_API_KEY=
CN_MODEL=deepseek-flash
# Optional: CN_TEMPERATURE (default 1.3), CN_JSON_MODE=0 to stop asking for JSON mode.

# Overseas: any OpenAI-compatible endpoint. Left empty, overseas requests use the CN provider.
INTL_BASE_URL=
INTL_API_KEY=
INTL_MODEL=
# Optional: INTL_TEMPERATURE (default 1), INTL_JSON_MODE=0.

# Set to 1 to answer with canned text and call no provider (for local testing).
AI_MOCK=0
